	local button = script.Parent
	local usernameBox = button.Parent:WaitForChild("UsernameBox")
	
	local enabled = false
	
	local function findPlayer(input)
		input = input:gsub("^%s+", ""):gsub("%s+$", ""):lower()
	
		if input == "" then
			return nil
		end
	
		-- Exact username or display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower() == input
				or player.DisplayName:lower() == input then
				return player
			end
		end
	
		-- Partial username/display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower():sub(1, #input) == input
				or player.DisplayName:lower():sub(1, #input) == input then
				return player
			end
		end
	
		return nil
	end
	
	local function teleportToPlayer()
		if not enabled then
			return
		end
	
		local target = findPlayer(usernameBox.Text)
	
		if not target then
			button.Text = "PLAYER NOT FOUND"
	
			task.delay(1.5, function()
				if enabled then
					button.Text = "TELEPORT: ON"
				else
					button.Text = "TELEPORT: OFF"
				end
			end)
	
