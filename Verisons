local function WBGEX_fake_script() -- aimlock.LocalScript 
	local script = Instance.new('LocalScript', aimlock)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local localPlayer = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	local button = script.Parent
	
	local enabled = false
	local lockedTarget = nil
	
	local maxDistance = 500
	
	local function isValidTarget(player)
		if player == localPlayer then
			return false
		end
	
		-- Team check
		if localPlayer.Team ~= nil and player.Team == localPlayer.Team then
			return false
		end
	
		local character = player.Character
		if not character then
			return false
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
	
		if not humanoid or humanoid.Health <= 0 or not root then
			return false
		end
	
		return true
	end
	
	local function getClosestEnemy()
		local myCharacter = localPlayer.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	
		if not myRoot then
			return nil
		end
	
		local closestPlayer = nil
		local closestDistance = maxDistance
	
		for _, player in ipairs(Players:GetPlayers()) do
			if isValidTarget(player) then
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				local distance = (root.Position - myRoot.Position).Magnitude
	
				if distance < closestDistance then
					closestDistance = distance
					closestPlayer = player
				end
			end
		end
	
		return closestPlayer
	end
	
	local function stopAimlock()
		enabled = false
		lockedTarget = nil
		button.Text = "AIMLOCK: OFF"
	end
	
	local function toggleAimlock()
		enabled = not enabled
	
		if enabled then
			button.Text = "AIMLOCK: ON"
		else
			lockedTarget = nil
			button.Text = "AIMLOCK: OFF"
		end
	end
	
	-- Button toggle
	button.MouseButton1Click:Connect(function()
		toggleAimlock()
	end)
	
	-- Q key toggle
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
	
	end)
	
	-- Camera locking
	RunService.RenderStepped:Connect(function()
		if not enabled then
			return
		end
	
		-- Find a new target if needed
		if not lockedTarget or not isValidTarget(lockedTarget) then
			lockedTarget = getClosestEnemy()
		end
	
		if lockedTarget and lockedTarget.Character then
			local targetPart = lockedTarget.Character:FindFirstChild("Head")
	
			if targetPart then
				camera.CFrame = CFrame.lookAt(
					camera.CFrame.Position,
					targetPart.Position
				)
			end
		end
	end)
	
