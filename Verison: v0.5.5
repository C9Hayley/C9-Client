local function IIFTA_fake_script() -- FollowButton.LocalScript 
	local script = Instance.new('LocalScript', FollowButton)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local localPlayer = Players.LocalPlayer
	local button = script.Parent
	local usernameBox = button.Parent:WaitForChild("UsernameBox")
	
	local following = false
	local targetPlayer = nil
	local followConnection = nil
	
	local FOLLOW_DISTANCE = 4
	
	local function findPlayer(input)
		input = input:gsub("^%s+", ""):gsub("%s+$", ""):lower()
	
		if input == "" then
			return nil
		end
	
		-- Exact username or display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower() == input
				or player.DisplayName:lower() == input then
				return player
			end
		end
	
		-- Partial username/display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower():sub(1, #input) == input
				or player.DisplayName:lower():sub(1, #input) == input then
				return player
			end
		end
	
		return nil
	end
	
	local function stopFollowing()
		following = false
		targetPlayer = nil
	
		if followConnection then
			followConnection:Disconnect()
			followConnection = nil
		end
	
		button.Text = "FOLLOW: OFF"
	end
	
	local function startFollowing()
		local target = findPlayer(usernameBox.Text)
	
		if not target then
			button.Text = "PLAYER NOT FOUND"
	
			task.delay(1.5, function()
				if not following then
					button.Text = "FOLLOW: OFF"
				end
			end)
	
			return
		end
	
		if target == localPlayer then
			button.Text = "CANNOT FOLLOW YOURSELF"
	
			task.delay(1.5, function()
				if not following then
					button.Text = "FOLLOW: OFF"
				end
			end)
	
			return
		end
	
		targetPlayer = target
		following = true
	
		button.Text = "FOLLOW: ON"
	
		-- Teleport beside them immediately
		local character = localPlayer.Character
		local targetCharacter = target.Character
	
		if character and targetCharacter then
			local root = character:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
			if root and targetRoot then
				root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 4)
			end
		end
	
		followConnection = RunService.Heartbeat:Connect(function()
			if not following or not targetPlayer then
				return
			end
	
			local character = localPlayer.Character
			local targetCharacter = targetPlayer.Character
	
			if not character or not targetCharacter then
				return
			end
	
			local root = character:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
			if root and targetRoot then
				local position =
					targetRoot.Position - targetRoot.CFrame.LookVector * FOLLOW_DISTANCE
	
				root.CFrame = CFrame.lookAt(
					position,
					targetRoot.Position
				)
			end
		end)
	end
	
	button.Activated:Connect(function()
		if following then
			stopFollowing()
		else
			startFollowing()
		end
	end)
	
	Players.PlayerRemoving:Connect(function(player)
		if player == targetPlayer then
			stopFollowing()
		end
	end)
	
	button.Text = "FOLLOW: OFF"
end
coroutine.wrap(IIFTA_fake_script)()
