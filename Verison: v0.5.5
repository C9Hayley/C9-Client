local function RUKNE_fake_script() -- ViewButton.LocalScript 
	local script = Instance.new('LocalScript', ViewButton)

	local Players = game:GetService("Players")
	
	local localPlayer = Players.LocalPlayer
	local button = script.Parent
	local usernameBox = button.Parent:WaitForChild("UsernameBox")
	
	local camera = workspace.CurrentCamera
	
	local viewing = false
	local targetPlayer = nil
	
	local function findPlayer(input)
		input = input:gsub("^%s+", ""):gsub("%s+$", ""):lower()
	
		if input == "" then
			return nil
		end
	
		-- Exact username or display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower() == input
				or player.DisplayName:lower() == input then
				return player
			end
		end
	
		-- Partial username/display name
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name:lower():sub(1, #input) == input
				or player.DisplayName:lower():sub(1, #input) == input then
				return player
			end
		end
	
		return nil
	end
	
	local function stopViewing()
		viewing = false
		targetPlayer = nil
	
		local character = localPlayer.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
	
			if humanoid then
				camera.CameraType = Enum.CameraType.Custom
				camera.CameraSubject = humanoid
			end
		end
	
		button.Text = "VIEW: OFF"
	end
	
	local function startViewing()
		local target = findPlayer(usernameBox.Text)
	
		if not target then
			button.Text = "PLAYER NOT FOUND"
	
			task.delay(1.5, function()
				if not viewing then
					button.Text = "VIEW: OFF"
				end
			end)
	
			return
		end
	
		if target == localPlayer then
			button.Text = "CANNOT VIEW YOURSELF"
	
			task.delay(1.5, function()
				if not viewing then
					button.Text = "VIEW: OFF"
				end
			end)
	
			return
		end
	
		local character = target.Character
		if not character then
			button.Text = "NO CHARACTER"
	
			task.delay(1.5, function()
				if not viewing then
					button.Text = "VIEW: OFF"
				end
			end)
	
			return
		end
	
		local humanoid = character:FindFirstChildOfClass("Humanoid")
	
		if not humanoid then
			button.Text = "NO HUMANOID"
			return
		end
	
		targetPlayer = target
		viewing = true
	
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	
		button.Text = "VIEW: ON"
	end
	
	button.Activated:Connect(function()
		if viewing then
			stopViewing()
		else
			startViewing()
		end
	end)
	
	-- If the target respawns, keep viewing them
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			if player == targetPlayer and viewing then
				local humanoid = character:WaitForChild("Humanoid", 5)
	
				if humanoid and viewing then
					camera.CameraType = Enum.CameraType.Custom
					camera.CameraSubject = humanoid
				end
			end
		end)
	end)
	
	-- Handle players already in the server
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function(character)
			if player == targetPlayer and viewing then
